# Copy this file to .env and fill it in. .env is never committed.
# Docker Compose reads .env and passes each service only the keys it needs.
# "Required" keys stop startup with a message naming the key if missing.
# Keys for later issues are optional until that issue lands.

# --- Compose ---------------------------------------------------------------
# "local" also starts the ngrok tunnel. Production uses its own profile (issue 16).
COMPOSE_PROFILES=local

# --- Postgres (required, issue 01) ----------------------------------------
# Credentials for the bundled Postgres + pgvector container. Pick any values.
POSTGRES_USER=companion
POSTGRES_PASSWORD=
POSTGRES_DB=companion

# --- Clerk (required, issue 01) -------------------------------------------
# From the Clerk dashboard > API keys.
# Secret key: used by the backend to verify sign-ins, and by the Dashboard's
# server for Clerk's middleware. Never exposed to the browser.
CLERK_SECRET_KEY=
# Publishable key: public, used by the Dashboard in the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Telegram (required, issue 01) ----------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# The bot's @username without the @, e.g. zeph_companion_bot.
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram sends it with every webhook call so the
# backend can reject fakes. Letters, numbers, _ and - only.
TELEGRAM_WEBHOOK_SECRET=

# --- ngrok (required locally, issue 01) -----------------------------------
# From the ngrok dashboard. A fixed domain keeps the webhook URL stable.
NGROK_AUTHTOKEN=
# e.g. zeph-dev.ngrok-free.app
NGROK_DOMAIN=

# --- Public URLs (required, issue 01) -------------------------------------
# Where Telegram posts updates. Locally: https://<NGROK_DOMAIN>
WEBHOOK_BASE_URL=
# The backend's address as the browser sees it (Dashboard API).
NEXT_PUBLIC_API_URL=http://localhost:8000
# The Dashboard's address; used in replies and to check sign-in tokens.
DASHBOARD_URL=http://localhost:3000

# --- Ports and worktrees (optional) ---------------------------------------
# Host ports; the defaults are shown. `make worktree-setup` sets other ports,
# its own COMPOSE_PROJECT_NAME and turns these off in a worktree's .env.
# WEB_PORT=3000
# BACKEND_PORT=8000
# POSTGRES_PORT=5432
# false makes this stack leave the bot's Telegram webhook alone.
# TELEGRAM_WEBHOOK_REGISTER=true

# --- DeepSeek (required, issue 02) ----------------------------------------
# From platform.deepseek.com > API keys. Writes the Companion's replies.
DEEPSEEK_API_KEY=

# --- Tavily (optional until issue 09) -------------------------------------
TAVILY_API_KEY=

# --- Adapter choice per port (optional; defaults shown) -------------------
# Which adapter backs each port (ADR-0003). Change only to swap a provider.
CHAT_CHANNEL_ADAPTER=telegram
AUTH_VERIFIER_ADAPTER=clerk
REPOSITORIES_ADAPTER=postgres
CLOCK_ADAPTER=system
# From issue 02:
CHAT_MODEL_ADAPTER=deepseek
# From issue 08:
EMBEDDER_ADAPTER=fastembed
VECTOR_STORE_ADAPTER=pgvector
TEXT_EXTRACTOR_ADAPTER=pypdf
# From issue 09:
WEB_SEARCH_ADAPTER=tavily
# From issue 11:
SCHEDULER_ADAPTER=in_process

# --- Model Call Log developer logs (optional) ------------------------------
# true prints every model call's full content (prompts, history, tool calls,
# answers) to the backend's logs. Turn it on in local and worktree .env files
# only, never production: it holds what Users say (ADR-0010).
MODEL_CALL_DEVELOPER_LOGS=false

# --- Initial Admins (optional until issue 04) -----------------------------
# Comma-separated emails that become Admins on first sign-in.
INITIAL_ADMIN_EMAILS=

# --- Production (optional until issue 16) ---------------------------------
# The domain Caddy serves over HTTPS, e.g. zeph.example.com
PRODUCTION_DOMAIN=
